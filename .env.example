# HEALO Environment Variables Example

# ============================================
# Database (Supabase)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Admin Authentication
# ============================================
# 쉼표로 구분된 관리자 이메일 목록
# ⚠️ 주의: 변수명은 ADMIN_EMAIL_ALLOWLIST 입니다 (ADMIN_EMAILS 아님)
ADMIN_EMAIL_ALLOWLIST=admin@healo.com,manager@healo.com

# ============================================
# AWS SES (Email Notifications)
# ============================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=noreply@healo.com

# ============================================
# Admin Notifications
# ============================================
# SMS는 아직 실제 발송하지 않음 (Mock mode)
# Email은 AWS SES로 실제 발송

# ENV Fallback (비상용 - 선택사항)
ADMIN_PHONE_NUMBERS=+821012345678,+821087654321

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3000
